<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= type %> | Admin</title><link rel="stylesheet" href="/assets/css/styles.css"></head><body><main class="section"><div class="container"><p><a href="/admin">← Dashboard</a></p><h1>Manage <%= type %></h1><% if(type!=='bookings'){ %><form method="post" enctype="multipart/form-data" class="grid"><input name="name" placeholder="name/title"><input name="title" placeholder="title"><input name="slug" placeholder="slug"><textarea name="description" placeholder="description"></textarea><textarea name="content" placeholder="content"></textarea><input name="seo_title" placeholder="seo title"><input name="seo_description" placeholder="seo description"><input name="pricing" placeholder="pricing"><textarea name="faqs" placeholder='faqs JSON'></textarea><input name="category" placeholder="category"><input type="file" name="image"><button class="btn btn-primary">Add</button></form><% } %><div class="grid"><% rows.forEach(r=>{ %><div class="card"><pre style="white-space:pre-wrap"><%= JSON.stringify(r,null,2) %></pre><% if(type==='bookings'){ %><form method="post" action="/admin/bookings/<%= r.id %>/status"><input name="status" value="<%= r.status %>"><button class="btn btn-outline">Update Status</button></form><% } %><form method="post" action="/admin/<%= type %>/<%= r.id %>/delete"><button class="btn btn-outline">Delete</button></form></div><% }) %></div></div></main></body></html>
